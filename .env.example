# ============================================
# NumberDepot — Environment Variables
# ============================================
# Copy to apps/web/.env.local for local dev
# Copy to .env for Docker deployment

# ── MongoDB ──
# Local dev (Atlas):
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/numberdepot
# Docker deployment (auto-configured via MONGO_USER/MONGO_PASS):
MONGO_USER=admin
MONGO_PASS=your_strong_password_here

# ── Email (Resend) ──
RESEND_API_KEY=re_your_resend_api_key

# ── JWT Authentication ──
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ── App URL ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://numberdepotinc.com

# ── NumberBarn API ──
NUMBERBARN_API_TOKEN=your_numberbarn_api_token
NUMBERBARN_MARKUP=15

# ── Docker ──
PORT=3000

# ── Authorize.Net ──
# "production" = live gateway (real money). Anything else = sandbox.
AUTHORIZENET_ENV=sandbox
AUTHORIZENET_API_LOGIN_ID=your_api_login_id
AUTHORIZENET_TRANSACTION_KEY=your_transaction_key
AUTHORIZENET_SIGNATURE_KEY=your_signature_key_for_webhooks
NEXT_PUBLIC_AUTHORIZENET_ENV=sandbox
NEXT_PUBLIC_AUTHORIZENET_CLIENT_KEY=your_public_client_key
NEXT_PUBLIC_AUTHORIZENET_API_LOGIN_ID=your_api_login_id
