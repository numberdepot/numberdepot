# === NumberDepot — VPS / Docker environment ===
# Copy this file to .env next to docker-compose.yml and fill in real values.
#   cp .env.docker .env
#
# docker-compose builds MONGODB_URI from MONGO_USER / MONGO_PASS — do not set
# MONGODB_URI here, it is only used when running against an external database.

# --- MongoDB (container) ---
MONGO_USER=numberdepot
MONGO_PASS=change_this_to_a_long_random_password

# --- JWT ---
# Must be long and random. Changing it logs every user out.
JWT_SECRET=change_this_to_a_long_random_secret

# --- Email (Resend) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=NumberDepot <noreply@numberdepot.net>

# --- App URL ---
# Baked into the browser bundle at build time. Rebuild after changing it.
NEXT_PUBLIC_APP_URL=https://numberdepot.net

# Host port the app listens on. With the proxy profile, Caddy owns 80/443 and
# this stays internal.
PORT=3000

# --- NumberBarn ---
NUMBERBARN_API_TOKEN=
NUMBERBARN_MARKUP=15

# --- Authorize.Net ---
# "production" charges real cards. Anything else uses the sandbox endpoint.
# Keep both ENV values in step — the first drives the server, the second the
# browser's Accept.js host.
AUTHORIZENET_ENV=sandbox
NEXT_PUBLIC_AUTHORIZENET_ENV=sandbox

AUTHORIZENET_API_LOGIN_ID=
AUTHORIZENET_TRANSACTION_KEY=
# Only needed once webhooks are implemented.
AUTHORIZENET_SIGNATURE_KEY=

# Public by design — safe to expose in the browser bundle.
NEXT_PUBLIC_AUTHORIZENET_CLIENT_KEY=
NEXT_PUBLIC_AUTHORIZENET_API_LOGIN_ID=
